{
  "name": "down-the-code",
  "description": "Travel photography and paintings showcase",
  "version": "1.0.0",
  "author": "Raja Bellebon <rbellebon@gmail.com>",
  "dependencies": {
    "@babel/preset-env": "^7.23.0",
    "@emotion/react": "^11.13.0",
    "gatsby": "^3.1.0",
    "gatsby-image": "^3.1.0",
    "gatsby-plugin-emotion": "^6.1.0",
    "gatsby-plugin-env-variables": "^2.1.0",
    "gatsby-plugin-manifest": "^3.1.0",
    "gatsby-plugin-react-helmet": "^4.1.0",
    "gatsby-plugin-sharp": "^3.1.0",
    "gatsby-plugin-testing": "^0.3.4",
    "gatsby-plugin-typescript": "^3.1.0",
    "gatsby-source-filesystem": "^3.1.0",
    "gatsby-transformer-remark": "^3.1.0",
    "gatsby-transformer-sharp": "^3.1.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "reactstrap": "^9.2.0"
  },
  "keywords": [
    "down-the-code",
    "tulec"
  ],
  "license": "MIT",
  "scripts": {
    "build": "NODE_OPTIONS=--openssl-legacy-provider gatsby build",
    "clean": "rm -rf .cache && rm -rf node_modules && yarn",
    "serve": "NODE_OPTIONS=--openssl-legacy-provider gatsby serve",
    "develop": "NODE_OPTIONS=--openssl-legacy-provider gatsby develop",
    "start": "npm run develop",
    "format": "prettier --write \"src/**/*.{js,ts,tsx}\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:e2e": "cypress run",
    "test:e2e:ci": "START_SERVER_AND_TEST_INSECURE=1 start-server-and-test develop 8000 test:e2e",
    "test:e2e:watch": "cypress open"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-helmet": "^6.1.0",
    "@types/react-test-renderer": "^18.0.0",
    "@types/reactstrap": "^8.7.2",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "babel-preset-gatsby": "^0.1.6",
    "cypress": "^13.6.0",
    "dotenv": "^16.3.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "react-media": "^1.9.2",
    "source-map": "^0.6.1",
    "start-server-and-test": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,json,css,md}": [
      "prettier --write \"src/**/*.{js,ts,tsx}\"",
      "git add"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RajaBellebon/tulec"
  },
  "packageManager": "yarn@4.5.0+sha512.837566d24eec14ec0f5f1411adb544e892b3454255e61fdef8fd05f3429480102806bac7446bc9daff3896b01ae4b62d00096c7e989f1596f2af10b927532f39",
  "resolutions": {
    "postcss": "^8.4.31"
  }
}
